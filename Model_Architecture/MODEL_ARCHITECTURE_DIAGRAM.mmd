flowchart TD
    %% Training schedule: WSD = 500-step warmup, stable middle, final 20% decay.
    A["Clamped input · power fog 0..0.8<br/>[B, Li], Li ≤ 4096"] --> E["Shared token embedding<br/>291 → 384"]
    AF["Input features<br/>25 values + 25 validity<br/>309 categorical + 1 allegiance<br/>= 360"] --> FM["Feature MLP<br/>360 → 32 → 32"]
    E --> JM["Joint mixer<br/>(384 + 32) → 384 → 384"]
    FM --> JM
    JM --> IE["Input embeddings<br/>[B, Li, 384]"]

    T["Clean target canvas<br/>BOS at 0 · outcome at 1<br/>[B, 4096]"] --> C["Uniform-state corruption<br/>t ~ Beta(2,1) · 5% exact t=1<br/>noise = PAD/DELIMITER/content"]
    C --> NE["Noised canvas IDs<br/>[B, 4096]"]
    NE --> E2["Same token embedding<br/>291 → 384"]

    FP["Stopped previous prediction<br/>[B, 4096, 291]"] --> EX["Expected embedding<br/>softmax(logits) × E<br/>→ [B, 4096, 384]"]
    EX --> SC["RMSNorm → GeGLU 384<br/>→ residual → scale-less RMSNorm"]
    E2 --> SC
    SC --> CE["Canvas embeddings<br/>[B, 4096, 384]"]

    IE --> CAT["Frozen input K/V + canvas queries<br/>[B, Li + 4096, 384]"]
    CE --> CAT

    CAT --> TR["12 × transformer block<br/>6-head MHA · GeGLU 1536 · sandwich RMSNorm"]
    TR --> FN["Final RMSNorm"]
    FN --> OH["Untied output head<br/>384 → 291"]
    OH --> FULL["Full logits<br/>[B, Li + 4096, 291]"]
    FULL --> SLICE["Canvas slice<br/>[B, 4096, 291]"]
    SLICE --> LOSS["Weighted clean-state cross-entropy<br/>6 rows × 7 accumulations = 42 windows/update<br/>PAD 0.1 · END 24.6333"]
    LOSS --> DEC["Read-only decompositions<br/>7 classes · 4 t-buckets<br/>preserved vs noised · p1/p2<br/>5 future-distance buckets"]

    %% Inference: nonmonotonic uniform entropy-bounded sampling, at most 64 passes.
    %% A pass is TERMINAL when the certificate fires or the ceiling ends the row;
    %% a terminal pass commits every eligible position and renoises nothing, so
    %% the returned canvas is exactly the state the stop decision validated.
    SLICE --> SAMP["Sampling pass · at most 64<br/>temperature 0.8 → 0.4<br/>[MASK] logit = −inf"]
    SAMP --> FIX["Stop certificate<br/>argmax == canvas at every<br/>mutable position AND<br/>mean entropy &lt; 0.005"]
    FIX --> EBA["Not terminal<br/>EB accept cumsum(h) − h ≤ 0.1<br/>renoise the rest → next pass"]
    EBA --> SAMP
    FIX --> TERM["Terminal pass<br/>certified, or the 64th<br/>accept EVERY eligible position<br/>no renoising"]
    TERM --> RET["Returned canvas<br/>[B, 4096]"]
